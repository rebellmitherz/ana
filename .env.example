# =============================================================================
# ALUBALI — Umgebungsvariablen
#
# Kopiere diese Datei nach .env.local und fülle aus, was du brauchst.
#
# WICHTIG: ALUBALI läuft OHNE jede einzige dieser Variablen.
# Ohne Konfiguration startet die App im DEMO-MODUS:
#   * lokaler Datenspeicher unter .data/ statt Supabase
#   * Mock-AI mit realistischen, fest hinterlegten Antworten
#   * Mock-Speech mit georgischen Beispiel-Transkripten
#   * automatische Demo-Session (kein Login nötig)
# Damit ist jeder Flow sofort klickbar. Keys machen ihn echt, nicht möglich.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase  (optional — ohne diese Werte läuft der lokale Datenspeicher)
# -----------------------------------------------------------------------------
# Projekt in der Region EU (Frankfurt) anlegen.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nur serverseitig. Wird ausschließlich für Seed und Cron-Jobs verwendet.
# Darf NIEMALS mit NEXT_PUBLIC_ beginnen und niemals im Client landen.
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# AI-Provider  (optional — ohne Key läuft der Mock-Provider)
# -----------------------------------------------------------------------------
# Reihenfolge der Bevorzugung: anthropic > openai > mock
AI_PROVIDER=

# Anthropic
ANTHROPIC_API_KEY=
# Optionale Modell-Overrides pro Tier (Standardwerte siehe core/ai/router.ts)
AI_MODEL_NANO=
AI_MODEL_STANDARD=
AI_MODEL_VISION=

# OpenAI (Fallback-Provider)
OPENAI_API_KEY=


# -----------------------------------------------------------------------------
# Speech-to-Text  (optional — ohne Key läuft der Mock-Provider)
# -----------------------------------------------------------------------------
# 'openai' | 'mock'
SPEECH_PROVIDER=
SPEECH_MODEL=gpt-4o-transcribe


# -----------------------------------------------------------------------------
# Anwendung
# -----------------------------------------------------------------------------
# Basis-URL, für OAuth-Redirects und Signed URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo-Daten beim ersten Start automatisch anlegen (empfohlen für V1)
SEED_DEMO_DATA=true

# Monatliches AI-Budget in USD. Bei Überschreitung greift der Hard-Cap.
AI_MONTHLY_BUDGET_USD=25

# Geheimnis für die Demo-Session-Signatur (nur im Demo-Modus verwendet).
# In Produktion mit Supabase Auth irrelevant.
DEMO_SESSION_SECRET=
